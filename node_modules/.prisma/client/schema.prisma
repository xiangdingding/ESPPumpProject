generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/esp.db"
}

// ==================== 基础数据 ====================

model OilField {
  id        String   @id @default(cuid())
  name      String   @unique
  region    String
  createdAt DateTime @default(now())
  blocks    Block[]
}

model Block {
  id         String   @id @default(cuid())
  name       String
  oilFieldId String
  oilField   OilField @relation(fields: [oilFieldId], references: [id])
  wells      Well[]
  createdAt  DateTime @default(now())

  @@unique([oilFieldId, name])
}

// ==================== 井信息 ====================

model Well {
  id              String    @id @default(cuid())
  wellNo          String    @unique
  name            String
  blockId         String
  block           Block     @relation(fields: [blockId], references: [id])
  pumpType        String // ESP | PCP
  status          String    @default("normal") // normal | warning | alarm | offline
  depth           Float
  pumpDepth       Float
  strokeLength    Float?
  strokeFrequency Float?
  pumpDiameter    Float?
  rodDiameter     Float?
  installDate     DateTime?
  lastMaintenance DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  realtimeData        WellRealtimeData?
  productionRecords   ProductionRecord[]
  diagnosisRecords    DiagnosisRecord[]
  dynagraphRecords    DynagraphRecord[]
  optimizationSchemes OptimizationScheme[]
  alarmRecords        AlarmRecord[]
}

// ==================== 实时数据 ====================

model WellRealtimeData {
  id             String   @id @default(cuid())
  wellId         String   @unique
  well           Well     @relation(fields: [wellId], references: [id])
  casingPressure Float    @default(0)
  tubingPressure Float    @default(0)
  frequency      Float    @default(0)
  current        Float    @default(0)
  voltage        Float    @default(0)
  power          Float    @default(0)
  temperature    Float    @default(0)
  vibration      Float    @default(0)
  dailyLiquid    Float    @default(0)
  dailyOil       Float    @default(0)
  waterCut       Float    @default(0)
  efficiency     Float    @default(0)
  submergence    Float    @default(0)
  dynamicLevel   Float    @default(0)
  gasOilRatio    Float    @default(0)
  runDays        Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// ==================== 产量记录 ====================

model ProductionRecord {
  id             String   @id @default(cuid())
  wellId         String
  well           Well     @relation(fields: [wellId], references: [id])
  date           DateTime
  liquidVolume   Float
  oilVolume      Float
  waterVolume    Float
  gasVolume      Float
  waterCut       Float
  pumpEfficiency Float
  createdAt      DateTime @default(now())

  @@index([wellId, date])
}

// ==================== 工况诊断 ====================

model DiagnosisRecord {
  id              String   @id @default(cuid())
  wellId          String
  well            Well     @relation(fields: [wellId], references: [id])
  time            DateTime @default(now())
  type            String // 工况类型: normal, supply_insufficient, gas_lock, pump_leak...
  status          String // normal | warning | alarm
  description     String
  diagnosisMethod String? // 功图+参数, 电流诊断, 综合诊断...
  parameters      String // JSON: 诊断时的关键参数快照
  createdAt       DateTime @default(now())

  @@index([wellId, time])
  @@index([status])
}

model DynagraphRecord {
  id                String   @id @default(cuid())
  wellId            String
  well              Well     @relation(fields: [wellId], references: [id])
  time              DateTime @default(now())
  surfaceCard       String // JSON: [{displacement, load}]
  pumpCard          String // JSON: [{displacement, load}]
  workCondition     String
  workConditionCode String
  strokeLength      Float
  strokeFrequency   Float
  maxLoad           Float
  minLoad           Float
  cardArea          Float?
  pumpEfficiency    Float
  liquidProduction  Float
  createdAt         DateTime @default(now())

  @@index([wellId, time])
}

model WorkConditionType {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  category    String // normal | supply | gas | pump | rod | other
  description String
  features    String // JSON array
  suggestions String // JSON array
  severity    String // info | warning | danger
  cardShape   String
}

// ==================== 运行优化 ====================

model OptimizationScheme {
  id              String    @id @default(cuid())
  wellId          String
  well            Well      @relation(fields: [wellId], references: [id])
  type            String // 频率优化, 检泵作业, 增产提频, 维护保养
  priority        String // urgent | high | medium | low
  status          String    @default("draft") // draft | approved | executing | completed | cancelled
  currentParams   String // JSON
  suggestedParams String // JSON
  expectedResults String // JSON array
  steps           String // JSON array
  costEstimate    Float
  benefitEstimate Float
  reason          String
  riskAssessment  String
  approvedBy      String?
  approvedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  effectRecords OptimizationEffect[]

  @@index([wellId])
  @@index([status])
}

model OptimizationEffect {
  id            String             @id @default(cuid())
  schemeId      String
  scheme        OptimizationScheme @relation(fields: [schemeId], references: [id])
  recordDate    DateTime
  metric        String
  expectedValue Float
  actualValue   Float
  unit          String
  createdAt     DateTime           @default(now())

  @@index([schemeId, recordDate])
}

// ==================== 新井设计 ====================

model PumpModel {
  id                 String @id @default(cuid())
  series             String
  model              String @unique
  type               String // ESP | PCP
  manufacturer       String
  ratedDisplacement  Float
  ratedHead          Float
  ratedPower         Float
  ratedEfficiency    Float
  stages             Int
  outerDiameter      Float
  maxTemperature     Float
  maxGasContent      Float
  maxSandContent     Float
  minSubmergence     Float
  applicableDepthMin Float
  applicableDepthMax Float
  applicableProdMin  Float
  applicableProdMax  Float
  performanceCurve   String // JSON array
  price              Float
  mtbf               Int

  designSchemes DesignScheme[]
}

model DesignScheme {
  id               String     @id @default(cuid())
  name             String
  wellDepth        Float
  pumpType         String // ESP | PCP
  targetProduction Float
  targetHead       Float
  selectedPumpId   String?
  selectedPump     PumpModel? @relation(fields: [selectedPumpId], references: [id])
  designParams     String // JSON
  status           String     @default("designing") // designing | reviewed | approved | implemented
  designer         String
  reviewer         String?
  score            Float?
  reservoirParams  String? // JSON: 油藏参数
  fluidParams      String? // JSON: 流体参数
  wellboreParams   String? // JSON: 井筒参数
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ==================== 报警记录 ====================

model AlarmRecord {
  id             String    @id @default(cuid())
  wellId         String
  well           Well      @relation(fields: [wellId], references: [id])
  level          String // warning | alarm | critical
  type           String
  message        String
  parameter      String?
  value          Float?
  threshold      Float?
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([wellId, createdAt])
  @@index([level])
}

// ==================== 行业标准 ====================

model IndustryStandard {
  id       String @id @default(cuid())
  name     String
  unit     String
  minValue Float
  maxValue Float
  optimal  Float
  category String
}

// ==================== 系统用户 ====================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  realName  String
  role      String   @default("operator") // admin | engineer | operator
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== 操作日志 ====================

model OperationLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String
  action    String
  module    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([module, createdAt])
}
